    "@reduxjs/toolkit": "^1.9.7",
    "date-fns": "^2.30.0",
    "expo": "^54.0.20",
    "expo-document-picker": "^14.0.7",
    "expo-file-system": "^19.0.17",
    "expo-image-picker": "^17.0.8",
    "expo-sharing": "^14.0.7",
    "expo-sqlite": "~16.0.8",
    "mathjs": "^11.11.0",
    "react": "^18.2.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1302.0",
