{
  "name": "fermier-pro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace FermierPro.xcworkspace -scheme FermierPro -configuration Release",
    "expo:start": "expo start",
    "expo:start:tunnel": "expo start --tunnel",
    "expo:start:lan": "expo start --lan",
    "expo:start:localhost": "expo start --localhost"
  },
